# Supabase project settings (Project Settings > API in Supabase dashboard)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Used for signing our own JWTs (separate from Supabase Auth if you go that route)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

PORT=4000
NODE_ENV=development
