# Supabase project settings (Project Settings > API in Supabase dashboard)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Used for signing our own JWTs (separate from Supabase Auth if you go that route)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Local PostgreSQL mirror - every Supabase write is copied here (npm run db:setup / db:sync / db:verify)
DATABASE_URL=postgres://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/salesmesh
# Optional: self-healing resync timing (defaults shown)
# MIRROR_RETRY_SECONDS=30
# MIRROR_FULL_SYNC_MINUTES=10

# AI used by Deals > Import deals to read screenshots/photos/PDFs and match unfamiliar column names.
# Spreadsheet and CSV imports with known headings work without any AI.
#   AI_PROVIDER=ollama  free, runs on this computer: install https://ollama.com, then
#                       ollama pull qwen2.5:3b   (column matching, ~2 GB)
#                       ollama pull qwen2.5vl:3b (screenshots, ~3 GB; 1-3 minutes each on a laptop)
#   AI_PROVIDER=claude  Claude API, faster and more accurate, paid per use (https://platform.claude.com)
# Unset: claude if ANTHROPIC_API_KEY is set, otherwise ollama.
AI_PROVIDER=ollama
ANTHROPIC_API_KEY=
# Optional Ollama settings (defaults shown)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_TEXT_MODEL=qwen2.5:3b
# OLLAMA_VISION_MODEL=qwen2.5vl:3b
# OLLAMA_TIMEOUT_SECONDS=600

PORT=4000
NODE_ENV=development
