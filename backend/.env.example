# Supabase project settings (Project Settings > API in Supabase dashboard)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Used for signing our own JWTs (separate from Supabase Auth if you go that route)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Secret code that lets someone register as a Manager or Admin.
# Leave empty to allow representative sign-ups only.
ADMIN_SIGNUP_CODE=

# Local PostgreSQL mirror - every Supabase write is copied here (npm run db:setup / db:sync / db:verify)
DATABASE_URL=postgres://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/salesmesh
# Optional: self-healing resync timing (defaults shown)
# MIRROR_RETRY_SECONDS=30
# MIRROR_FULL_SYNC_MINUTES=10

PORT=4000
NODE_ENV=development
